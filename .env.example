# ============================================================
# syllabus-swarm — Environment Configuration
# ============================================================
# Copy this file to ".env" and fill in your actual values.
#   cp .env.example .env
#
# The ".env" file is git-ignored and must NEVER be committed.

# --- OpenRouter API -------------------------------------------------
# Sign up at https://openrouter.ai/ and generate an API key.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Model Selection ------------------------------------------------
# DeepSeek V4 Pro endpoint (or substitute your preferred model).
# See https://openrouter.ai/models for available identifiers.
OPENROUTER_MODEL=deepseek/deepseek-r1

# --- Optional: OpenRouter base URL (defaults below) -----------------
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Optional: Agent configuration ----------------------------------
# AGENT_TEMPERATURE=0.3
# AGENT_MAX_TOKENS=8192