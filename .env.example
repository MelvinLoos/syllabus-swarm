# ============================================================
# syllabus-swarm — Environment Configuration
# ============================================================
# Copy this file to ".env" and fill in your actual values.
#   cp .env.example .env
#
# The ".env" file is git-ignored and must NEVER be committed.

# --- OpenRouter API -------------------------------------------------
# Sign up at https://openrouter.ai/ and generate an API key.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ============================================================
#  Per-Agent Model Configuration  (Issue #5 / Issue #6)
# ============================================================
#
#  Naming convention:  AGENT_{ROLE}_{PROPERTY}
#  ─────────────────────────────────────────────
#    {ROLE}      → uppercase snake_case of the agent role
#                   e.g. CURRICULUM_ARCHITECT, LAB_DEVELOPER, OUTPUT_EXPORTER
#    {PROPERTY}  → MODEL, TEMPERATURE, MAX_TOKENS, TOP_P
#
#  Fallback priority (highest to lowest):
#    1. AGENT_{ROLE}_{PROPERTY}   ← per-agent override, most specific
#    2. AGENT_DEFAULT_{PROPERTY}  ← catch-all default for all agents
#    3. Legacy globals            ← OPENROUTER_MODEL / AGENT_TEMPERATURE /
#                                    AGENT_MAX_TOKENS (deprecated, kept for
#                                    backward compatibility)
#    4. Hardcoded defaults        ← values baked into src/llm_factory.py
#
#  All models are served via OpenRouter (https://openrouter.ai/api/v1).
#  See https://openrouter.ai/models for available model identifiers.

# --- OpenRouter base URL (defaults below) ---------------------------
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Default Agent Configuration (catch-all fallback) ---------------
# Every agent that does *not* have a per-agent override will use
# these defaults.  They replace the legacy OPENROUTER_MODEL /
# AGENT_TEMPERATURE / AGENT_MAX_TOKENS globals.
AGENT_DEFAULT_MODEL=deepseek/deepseek-r1
#     ^^^ Default model for all agents.  deepseek-r1 provides strong
#         reasoning capabilities suitable for most curriculum tasks.
AGENT_DEFAULT_TEMPERATURE=0.2
#     ^^^ Low temperature for deterministic, reproducible output
#          across all agents.  0.0 = fully deterministic, 1.0 = creative.
AGENT_DEFAULT_MAX_TOKENS=8192
#     ^^^ Maximum completion tokens per agent call.  8192 is generous
#          enough for long syllabi / lab suites without wasting tokens.

# --- Per-Agent Overrides (takes precedence over defaults above) -----

# -- Curriculum Architect --
# Needs deep reasoning to design coherent syllabi that weave together
# the Humanics framework (data literacy, tech literacy, human literacy)
# with experiential-learning pedagogy.
# Rationale: deepseek-v4-pro offers state-of-the-art reasoning with
#   strong multi-step planning — essential for crafting logically
#   coherent, pedagogically sound syllabi that span weeks of content.
AGENT_CURRICULUM_ARCHITECT_MODEL=deepseek/deepseek-v4-pro
# AGENT_CURRICULUM_ARCHITECT_TEMPERATURE=0.2   ← inherits from default
# AGENT_CURRICULUM_ARCHITECT_MAX_TOKENS=8192   ← inherits from default

# -- Lab & Project Developer --
# Needs code-generation precision with tight syntax correctness.
# Rationale: qwen3-coder is purpose-built for programming tasks —
#   it produces cleaner starter code, more idiomatic solutions,
#   and fewer hallucinated API calls than general-purpose models.
#   The 0.1 temperature ensures consistent code across multi-file labs.
AGENT_LAB_DEVELOPER_MODEL=qwen/qwen3-coder
AGENT_LAB_DEVELOPER_TEMPERATURE=0.1
#     ^^^ Even lower temperature for code: we want consistent,
#          correct syntax, not creative variation.
# AGENT_LAB_DEVELOPER_MAX_TOKENS=8192          ← inherits from default

# -- Output Exporter --
# Needs fast, cheap, deterministic formatting and file-tree generation.
# Rationale: deepseek-v4-flash-latest provides low-latency, low-cost
#   completions ideal for manifest generation, file assembly, and
#   Markdown packaging — tasks that need reliability, not deep reasoning.
#   Temperature 0.0 guarantees byte-identical output across runs.
AGENT_OUTPUT_EXPORTER_MODEL=deepseek/deepseek-v4-flash-latest
AGENT_OUTPUT_EXPORTER_TEMPERATURE=0.0
#     ^^^ Fully deterministic: export formatting should never vary
#          between runs.
# AGENT_OUTPUT_EXPORTER_MAX_TOKENS=8192        ← inherits from default